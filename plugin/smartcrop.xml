<?xml version="1.0" encoding="utf-8"?>
<extension type="plugin" group="content" method="upgrade">
    <name>PLG_CONTENT_SMARTCROP</name>
    <author>SuperSoft — Kontarinis Andreas</author>
    <authorEmail>ankont@sch.gr</authorEmail>
    <authorUrl>https://superor.wordpress.com/</authorUrl>
    <creationDate>2026-10-15</creationDate>
    <copyright>© 2026 SuperSoft — Kontarinis Andreas</copyright>
    <license>GNU General Public License version 2 or later; see LICENSE.txt</license>
    <version>1.4.0</version>
    <description>PLG_CONTENT_SMARTCROP_XML_DESCRIPTION</description>
    <namespace path="src">SuperSoft\Plugin\Content\SmartCrop</namespace>

    <files>
        <filename plugin="smartcrop">smartcrop.xml</filename>
        <folder plugin="smartcrop">services</folder>
        <folder>src</folder>
    </files>

    <media destination="plg_content_smartcrop" folder="media">
        <folder>css</folder>
        <folder>js</folder>
        <filename>joomla.asset.json</filename>
    </media>

    <languages folder="language">
        <language tag="en-GB">en-GB/plg_content_smartcrop.ini</language>
        <language tag="en-GB">en-GB/plg_content_smartcrop.sys.ini</language>
        <language tag="el-GR">el-GR/plg_content_smartcrop.ini</language>
        <language tag="el-GR">el-GR/plg_content_smartcrop.sys.ini</language>
    </languages>

    <config>
        <fields name="params">
            <fieldset name="basic">
                <field
                    name="supported_ratios"
                    type="subform"
                    label="PLG_CONTENT_SMARTCROP_PARAM_SUPPORTED_RATIOS_LABEL"
                    description="PLG_CONTENT_SMARTCROP_PARAM_SUPPORTED_RATIOS_DESC"
                    layout="joomla.form.field.subform.repeatable-table"
                    multiple="true"
                    groupByFieldset="false"
                    default='{"supported_ratios0":{"label":"Πλαίσιο άρθρου","width":"4","height":"3"},"supported_ratios1":{"label":"Hero Banner","width":"16","height":"9"},"supported_ratios2":{"label":"Τετράγωνο","width":"1","height":"1"}}'
                >
                    <form>
                        <field
                            name="label"
                            type="text"
                            label="PLG_CONTENT_SMARTCROP_PARAM_RATIO_NAME_LABEL"
                            required="true"
                        />
                        <field
                            name="width"
                            type="number"
                            label="PLG_CONTENT_SMARTCROP_PARAM_RATIO_WIDTH_LABEL"
                            min="1"
                            step="1"
                            required="true"
                        />
                        <field
                            name="height"
                            type="number"
                            label="PLG_CONTENT_SMARTCROP_PARAM_RATIO_HEIGHT_LABEL"
                            min="1"
                            step="1"
                            required="true"
                        />
                    </form>
                </field>
                <field
                    name="allow_custom_ratio"
                    type="radio"
                    label="PLG_CONTENT_SMARTCROP_PARAM_ALLOW_CUSTOM_LABEL"
                    description="PLG_CONTENT_SMARTCROP_PARAM_ALLOW_CUSTOM_DESC"
                    layout="joomla.form.field.radio.switcher"
                    default="1"
                >
                    <option value="1">JYES</option>
                    <option value="0">JNO</option>
                </field>
                <field
                    name="preview_max_width"
                    type="number"
                    label="PLG_CONTENT_SMARTCROP_PARAM_PREVIEW_MAX_WIDTH_LABEL"
                    description="PLG_CONTENT_SMARTCROP_PARAM_PREVIEW_MAX_WIDTH_DESC"
                    default="480"
                    min="240"
                    max="1200"
                    step="10"
                />
            </fieldset>
        </fields>
    </config>
</extension>
